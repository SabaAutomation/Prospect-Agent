# Copy to .env and edit. Everything is optional except your name and offer.
OLLAMA_HOST=http://localhost:11434
PROSPECT_MODEL=qwen2.5:7b
PROSPECT_SENDER_NAME=Your Name
PROSPECT_OFFER=websites with online booking and WhatsApp automation for local businesses
# Put a real contact in your user agent so site owners can reach you:
PROSPECT_USER_AGENT=ProspectAgent/0.1 (+you@example.com)
PROSPECT_DELAY=1.5
PROSPECT_MIN_SCORE=25
